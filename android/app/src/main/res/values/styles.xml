<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      只依赖系统自带的 Material 主题，不需要引入 androidx / material 库。
      windowBackground 用品牌色，让启动瞬间就是靛蓝，不闪白屏。
    -->
    <style name="Theme.HomeworkSentinel" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand_dark</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:navigationBarColor">@color/page_bg</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
