# 统一换行符，避免 Windows / macOS / Linux 之间反复产生整文件 diff
* text=auto eol=lf

# 明确按二进制处理，防止被当成文本转换而损坏
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jks binary
*.keystore binary
*.apk binary
*.zip binary
*.jar binary

# 这些是生成出来的文件，diff 时折叠
app/icons/*.png binary
android/app/src/main/res/mipmap-*/ic_launcher.png binary
docs/screenshots/*.png binary

# gradlew 在类 Unix 系统上需要可执行权限
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf
